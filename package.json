{
  "name": "gym-growth-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev",
    "build": "dotenv -e .env -- turbo build",
    "lint": "dotenv -e .env -- turbo lint",
    "test": "dotenv -e .env -- turbo test",
    "typecheck": "dotenv -e .env -- turbo typecheck",
    "db:generate": "dotenv -e .env -- pnpm --filter @gym/database generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @gym/database migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @gym/database seed"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
